# Same indentation and line endings in every editor (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
